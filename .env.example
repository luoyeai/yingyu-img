# 网页安装无需先复制本文件；仅供手动 CLI 初始化与配置参考。
APP_NAME=映屿Img
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://images.example.com
APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=image_vault
DB_USERNAME=image_vault
DB_PASSWORD=
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
# 留空使用APP_URL；独立图片域名须配置同一public/media目录和HTTPS
IMAGE_PUBLIC_URL=
MAIL_MAILER=log
